# =============================================================================
# spiritualresults.org — env var TEMPLATE
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER put real secrets in this template file.
# =============================================================================

# --- Database (Neon Postgres) -------------------------------------------------
# Create at: https://console.neon.tech → New Project → "spiritualresults"
# DATABASE_URL = pooled connection (with -pooler in hostname) for runtime
# DIRECT_URL = direct connection (no -pooler) for Prisma migrations + db push
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.HOST_REST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Clerk (standalone instance on spiritualresults.org) ---------------------
# Create at: https://dashboard.clerk.com → New Application → "Spiritual Results"
# This is its OWN Clerk instance, separate from the adaptensor.com SSO.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk redirects after sign-in / sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Anthropic (only needed when the Phase 2 AI generator is wired) ----------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Gemini / Imagen (Shrine background generator) ---------------------------
# Get at: https://aistudio.google.com/apikey  (project must have billing enabled
# for Imagen access). The same key works for Gemini text models too.
# IMAGEN_MODEL is optional; defaults to imagen-4.0-ultra-generate-001 (highest
# fidelity, ~30s per image). Override to imagen-4.0-generate-001 for standard
# quality, or imagen-4.0-fast-generate-001 for cheap/fast drafts. (Imagen 3
# model IDs were retired from the public Gemini API circa 2026.)
GEMINI_API_KEY="AIza..."
# IMAGEN_MODEL="imagen-4.0-ultra-generate-001"

# --- Vercel Blob (stores the generated shrine backgrounds) -------------------
# Created automatically when you add a Blob store to the Vercel project:
#   Vercel dashboard → Project → Storage → Create → Blob → "shrine-bg"
# The token is auto-injected into the Vercel env. For local dev, copy the
# BLOB_READ_WRITE_TOKEN value out of the Vercel project settings.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SPIRITUAL_AI_URL="https://spiritualresults.ai"
