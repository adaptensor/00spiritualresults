# =============================================================================
# spiritualresults.org — env var TEMPLATE
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER put real secrets in this template file.
# =============================================================================

# --- Database (Neon Postgres) -------------------------------------------------
# Create at: https://console.neon.tech → New Project → "spiritualresults"
# DATABASE_URL = pooled connection (with -pooler in hostname) for runtime
# DIRECT_URL = direct connection (no -pooler) for Prisma migrations + db push
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.HOST_REST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Clerk (standalone instance on spiritualresults.org) ---------------------
# Create at: https://dashboard.clerk.com → New Application → "Spiritual Results"
# This is its OWN Clerk instance, separate from the adaptensor.com SSO.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk redirects after sign-in / sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Anthropic (only needed when the Phase 2 AI generator is wired) ----------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SPIRITUAL_AI_URL="https://spiritualresults.ai"
